# Konfiguracja SMTP dla formularza kontaktowego (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=konto@example.com
SMTP_PASS=haslo-lub-app-password

# Adres, na który trafiają zgłoszenia z formularza
CONTACT_TO_EMAIL=marczykowska@gmail.com

# Adres nadawcy widoczny w wiadomości (domyślnie SMTP_USER, jeśli pominięte)
CONTACT_FROM_EMAIL=konto@example.com

PORT=3000

# --- Pomiar: Google tag (GA4 + Google Ads) ---
# Puste wartości = skrypty pomiarowe w ogóle się nie ładują.
# GA4 – identyfikator pomiaru, format G-XXXXXXXXXX
GA4_MEASUREMENT_ID=
# Google Ads – identyfikator konwersji, format AW-XXXXXXXXXX
GOOGLE_ADS_ID=
# Etykieta konwersji "wysłany formularz" (część po ukośniku w AW-XXXX/etykieta)
GOOGLE_ADS_LEAD_LABEL=
# Etykieta konwersji "kliknięcie w telefon" (opcjonalnie)
GOOGLE_ADS_PHONE_LABEL=
