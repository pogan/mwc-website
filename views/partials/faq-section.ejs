<%
  var faqCategory = typeof faqCategory !== 'undefined' ? faqCategory : 'slub';
  var faqHeading = typeof faqHeading !== 'undefined' ? faqHeading : 'Najczęściej zadawane pytania';
  var faqIdPrefix = typeof faqIdPrefix !== 'undefined' ? faqIdPrefix : faqCategory;
  var faqItems = site.faq.filter(function (item) { return item.category === faqCategory; });
%>
<% if (faqItems.length) { %>
<section class="section-pad bg-cream-2">
  <div class="container">
    <div class="text-center mb-5" data-reveal>
      <p class="kicker">Pytania i odpowiedzi</p>
      <h2 class="section-title"><%= faqHeading %></h2>
    </div>
    <div class="row justify-content-center">
      <div class="col-lg-9">
        <div class="accordion" id="faqAccordion-<%= faqIdPrefix %>" data-reveal>
          <% faqItems.forEach(function (item, i) { %>
            <div class="accordion-item">
              <h3 class="accordion-header" id="faqHeading-<%= faqIdPrefix %>-<%= i %>">
                <button
                  class="accordion-button <%= i === 0 ? '' : 'collapsed' %>"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#faqCollapse-<%= faqIdPrefix %>-<%= i %>"
                  aria-expanded="<%= i === 0 ? 'true' : 'false' %>"
                  aria-controls="faqCollapse-<%= faqIdPrefix %>-<%= i %>"
                >
                  <%= item.q %>
                </button>
              </h3>
              <div
                id="faqCollapse-<%= faqIdPrefix %>-<%= i %>"
                class="accordion-collapse collapse <%= i === 0 ? 'show' : '' %>"
                aria-labelledby="faqHeading-<%= faqIdPrefix %>-<%= i %>"
                data-bs-parent="#faqAccordion-<%= faqIdPrefix %>"
              >
                <div class="accordion-body"><%= item.a %></div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</section>
<% } %>
