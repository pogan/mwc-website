<%
  /*
   * Google tag (gtag.js) – wspólny dla GA4 i Google Ads, z Consent Mode v2.
   * Ładuje się tylko, gdy w konfiguracji (data/site.js ← .env) ustawiono
   * przynajmniej jeden identyfikator. Skrypt inline dostaje nonce z CSP.
   *
   * Tryb podstawowy (basic): zgody są domyślnie odrzucone, a sam gtag.js
   * pobiera dopiero public/js/consent.js po kliknięciu „Akceptuję” w pasku
   * cookies. Zdarzenia wywołane wcześniej (np. konwersja na stronie
   * podziękowania) czekają w dataLayer i wysyłają się dopiero po zgodzie.
   */
  var a = site.analytics;
%>
<% if (a && a.enabled) { %>
  <script nonce="<%= cspNonce %>">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied'
    });
    gtag('set', 'ads_data_redaction', true);
    gtag('js', new Date());

    /* Identyfikator, którym consent.js ładuje gtag.js po wyrażeniu zgody. */
    window.MM_GTAG_ID = '<%= a.ga4Id || a.googleAdsId %>';

    /* Bez parametrów fbclid/igshid z Facebooka i Instagrama – inaczej każde wejście
       z social mediów jest w raportach GA4 osobną „stroną docelową”. gclid zostaje,
       bo Google Ads potrzebuje go do przypisania konwersji. */
    var mmPageLocation = (function () {
      try {
        var u = new URL(window.location.href);
        ['fbclid', 'igshid', 'mibextid'].forEach(function (p) { u.searchParams.delete(p); });
        return u.toString();
      } catch (e) { return window.location.href; }
    })();

    <% if (a.ga4Id) { %>gtag('config', '<%= a.ga4Id %>', { page_location: mmPageLocation });<% } %>
    <% if (a.googleAdsId) { %>gtag('config', '<%= a.googleAdsId %>');<% } %>

    /* Etykieta konwersji Google Ads dla kliknięcia w telefon (używana w /js/main.js). */
    window.MM_ADS_PHONE_LABEL = '<%= a.phoneConversionLabel || "" %>';

    /* Pomocnik: zdarzenie GA4 + (opcjonalnie) konwersja Google Ads. */
    window.mmTrack = function (eventName, params) {
      params = params || {};
      try { gtag('event', eventName, params); } catch (e) {}
    };
    window.mmAdsConversion = function (label, params) {
      <% if (a.googleAdsId) { %>
      if (!label) return;
      try {
        gtag('event', 'conversion', Object.assign(
          { send_to: '<%= a.googleAdsId %>/' + label },
          params || {}
        ));
      } catch (e) {}
      <% } %>
    };
  </script>
  <script src="/js/consent.js" defer></script>

  <% if (typeof trackLead !== 'undefined' && trackLead) { %>
    <script nonce="<%= cspNonce %>">
      window.mmTrack('generate_lead', { currency: 'PLN', value: 0 });
      <% if (a.leadConversionLabel) { %>window.mmAdsConversion('<%= a.leadConversionLabel %>');<% } %>
    </script>
  <% } %>
<% } %>
