<section class="page-hero" style="--hero-image: url('<%= heroImage %>')">
  <div class="page-hero__overlay"></div>
  <div class="container page-hero__inner" data-reveal>
    <% if (typeof heroKicker !== 'undefined' && heroKicker) { %>
      <p class="kicker kicker--light"><%= heroKicker %></p>
    <% } %>
    <h1 class="page-hero__title"><%= heroTitle %></h1>
    <% if (typeof heroSubtitle !== 'undefined' && heroSubtitle) { %>
      <p class="page-hero__subtitle"><%= heroSubtitle %></p>
    <% } %>
  </div>
</section>
