<%- include('../partials/page-hero', {
  heroImage: '/images/ceremony-inclusive.jpg',
  heroKicker: 'Masz pytania?',
  heroTitle: 'Najczęściej zadawane pytania',
  heroSubtitle: 'Zebrałam odpowiedzi na pytania, które najczęściej słyszę. Jeśli czegoś brakuje – napiszcie śmiało.'
}) %>

<section class="section-pad bg-cream">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-9">
        <div class="accordion" id="faqAccordion" data-reveal>
          <% site.faq.forEach(function (item, i) { %>
            <div class="accordion-item">
              <h2 class="accordion-header" id="faqHeading<%= i %>">
                <button
                  class="accordion-button <%= i === 0 ? '' : 'collapsed' %>"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#faqCollapse<%= i %>"
                  aria-expanded="<%= i === 0 ? 'true' : 'false' %>"
                  aria-controls="faqCollapse<%= i %>"
                >
                  <%= item.q %>
                </button>
              </h2>
              <div
                id="faqCollapse<%= i %>"
                class="accordion-collapse collapse <%= i === 0 ? 'show' : '' %>"
                aria-labelledby="faqHeading<%= i %>"
                data-bs-parent="#faqAccordion"
              >
                <div class="accordion-body"><%= item.a %></div>
              </div>
            </div>
          <% }); %>
        </div>

        <div class="text-center mt-5" data-reveal>
          <p class="lead-soft">Nie znaleźliście odpowiedzi na swoje pytanie?</p>
          <a href="/kontakt" class="btn btn-primary">Zadaj je bezpośrednio</a>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/cta') %>
