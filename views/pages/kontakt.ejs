<%
  var f = (typeof form !== 'undefined' && form) ? form : { values: {}, errors: [], success: false };
  var v = f.values || {};
%>
<%- include('../partials/page-hero', {
  heroImage: '/images/wedding-arch.webp',
  heroKicker: 'Porozmawiajmy',
  heroTitle: 'Kontakt',
  heroSubtitle: 'Zapraszam na spotkanie osobiste lub online. Poznamy się bliżej i opowiem, jak będziemy działać.'
}) %>

<section class="section-pad bg-cream">
  <div class="container">
    <div class="row g-5">
      <!-- Dane kontaktowe -->
      <div class="col-lg-5" data-reveal>
        <p class="kicker">Dane kontaktowe</p>
        <h2 class="section-title">Czekam na Waszą wiadomość</h2>
        <p class="text-muted-soft mb-4">
          Mam nadzieję, że mogę być częścią Waszej wyjątkowej historii. Jestem gotowa
          odpowiedzieć na wszystkie pytania i pomóc w zorganizowaniu idealnego dnia.
        </p>

        <div class="contact-detail">
          <span class="contact-detail__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
          </span>
          <div>
            <div class="contact-detail__label">Telefon</div>
            <div class="contact-detail__value"><a href="tel:<%= contact.phoneHref %>"><%= contact.phoneDisplay %></a></div>
          </div>
        </div>

        <div class="contact-detail">
          <span class="contact-detail__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          </span>
          <div>
            <div class="contact-detail__label">E-mail</div>
            <div class="contact-detail__value"><a href="mailto:<%= contact.email %>"><%= contact.email %></a></div>
          </div>
        </div>

        <div class="contact-detail">
          <span class="contact-detail__icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <div>
            <div class="contact-detail__label">Działam w</div>
            <div class="contact-detail__value" style="font-size: 1rem;"><%= contact.city %> i cała Polska</div>
          </div>
        </div>

        <div class="footer-social mt-4" style="justify-content: flex-start;">
          <a href="<%= contact.facebook %>" target="_blank" rel="noopener" aria-label="Facebook" style="border-color: rgba(138,90,68,.3); color: var(--clay);">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/></svg>
          </a>
          <a href="<%= contact.instagram %>" target="_blank" rel="noopener" aria-label="Instagram" style="border-color: rgba(138,90,68,.3); color: var(--clay);">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2.2c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.21 15.58 2.2 15.2 2.2 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.21 8.8 2.2 12 2.2Zm0 8.06a4.94 4.94 0 1 0 0 9.88 4.94 4.94 0 0 0 0-9.88Zm6.29-.2a1.15 1.15 0 1 1-2.3 0 1.15 1.15 0 0 1 2.3 0Z"/></svg>
          </a>
        </div>
      </div>

      <!-- Formularz -->
      <div class="col-lg-7" data-reveal data-reveal-delay="1">
        <div class="contact-card">
          <h3 class="mb-4" style="font-size: 1.6rem;">Napisz do mnie</h3>

          <% if (f.success) { %>
            <div class="alert alert-success alert-soft" role="alert">
              Dziękuję! Twoja wiadomość została przygotowana do wysłania. Odezwę się najszybciej, jak to możliwe.
            </div>
          <% } %>

          <% if (f.errors && f.errors.length) { %>
            <div class="alert alert-danger alert-soft" role="alert">
              <ul class="mb-0 ps-3">
                <% f.errors.forEach(function (err) { %><li><%= err %></li><% }); %>
              </ul>
            </div>
          <% } %>

          <form action="/kontakt" method="POST" novalidate>
            <div class="row g-3">
              <div class="col-md-6">
                <label for="name" class="form-label">Imię i nazwisko *</label>
                <input type="text" class="form-control" id="name" name="name" value="<%= v.name || '' %>" required minlength="2" />
              </div>
              <div class="col-md-6">
                <label for="email" class="form-label">E-mail *</label>
                <input type="email" class="form-control" id="email" name="email" value="<%= v.email || '' %>" required />
              </div>
              <div class="col-md-6">
                <label for="phone" class="form-label">Telefon</label>
                <input type="tel" class="form-control" id="phone" name="phone" value="<%= v.phone || '' %>" />
              </div>
              <div class="col-md-6">
                <label for="eventType" class="form-label">Rodzaj ceremonii</label>
                <select class="form-select" id="eventType" name="eventType">
                  <% var types = ['Ceremonia ślubna','Para LGBT+','Przywitanie dziecka','Ceremonia pożegnania','Odnowienie przysięgi','Inne']; %>
                  <option value="">— wybierz —</option>
                  <% types.forEach(function (t) { %>
                    <option value="<%= t %>" <%= v.eventType === t ? 'selected' : '' %>><%= t %></option>
                  <% }); %>
                </select>
              </div>
              <div class="col-12">
                <label for="message" class="form-label">Wiadomość *</label>
                <textarea class="form-control" id="message" name="message" rows="5" required minlength="10" placeholder="Opowiedzcie mi kilka słów o sobie i o wymarzonej ceremonii – data, miejsce, liczba gości..."><%= v.message || '' %></textarea>
              </div>
              <div class="col-12">
                <button type="submit" class="btn btn-primary btn-lg w-100">Wyślij wiadomość</button>
                <p class="text-muted-soft mt-3 mb-0" style="font-size: 0.82rem;">
                  * pola wymagane. Wysyłając formularz, wyrażasz zgodę na kontakt w sprawie zapytania.
                </p>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
