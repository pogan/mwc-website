<%- include('../partials/page-hero', {
  heroImage: '/images/couple-samesex.webp',
  heroKicker: 'Miłość bez ograniczeń',
  heroTitle: 'Ceremonie dla par LGBT+',
  heroSubtitle: 'Każda miłość zasługuje na to, by ją świętować – pięknie, głośno i bez wyjątków.'
